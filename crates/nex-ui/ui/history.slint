// Nex Speed history window: bars of daily data usage (download + upload), last 7 or 30 days.

import { Colors } from "theme.slint";
import { NxCard, NxSegment, NxStat } from "widgets.slint";

export component History inherits Window {
    in property <image> chart;
    in-out property <int> range: 7;
    in property <string> total-text: "";
    in property <string> down-text: "";
    in property <string> up-text: "";
    in property <string> from-text: "";
    in property <string> to-text: "";
    in property <string> peak-text: "";
    callback range-changed(int);

    icon: @image-url("icon.png");
    title: "Nex Speed · History";
    background: Colors.bg;
    preferred-width: 456px;
    preferred-height: 392px;
    min-width: 456px;
    max-width: 456px;
    min-height: 392px;
    max-height: 392px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        // Title and 7 / 30 day switch.
        HorizontalLayout {
            height: 32px;
            Text {
                text: "Data usage";
                color: Colors.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 168px;
                background: Colors.button;
                border-radius: 9px;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    NxSegment {
                        text: "7 days";
                        selected: root.range == 7;
                        clicked => {
                            root.range = 7;
                            root.range-changed(7);
                        }
                    }
                    NxSegment {
                        text: "30 days";
                        selected: root.range == 30;
                        clicked => {
                            root.range = 30;
                            root.range-changed(30);
                        }
                    }
                }
            }
        }

        // Daily bars with the first and last date underneath.
        NxCard {
            height: 208px;
            Image {
                source: root.chart;
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: 156px;
                image-fit: fill;
            }
            Text { x: 12px; y: 178px; width: 200px; text: root.from-text; color: Colors.dim; font-size: 11px; }
            Text {
                x: parent.width - 12px - 200px;
                y: 178px;
                width: 200px;
                text: root.to-text;
                color: Colors.dim;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }

        // Totals for the period; the colors double as the chart legend.
        HorizontalLayout {
            spacing: 12px;
            height: 58px;
            NxStat { label: "Total"; value: root.total-text; }
            NxStat { label: "● Download"; value: root.down-text; value-color: Colors.down; }
            NxStat { label: "● Upload"; value: root.up-text; value-color: Colors.up; }
        }

        Text { text: root.peak-text; color: Colors.dim; font-size: 12px; }
    }
}
