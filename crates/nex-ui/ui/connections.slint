// Nex Speed: active connections window (opened from the details window or the tray).
// Follows the light/dark theme, resizable.

import { Colors } from "theme.slint";
import { NxCard } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export struct ConnRow {
    process: string,
    remote: string,
}

export component Connections inherits Window {
    in property <[ConnRow]> rows;
    in property <string> summary: "";
    in property <string> note: "";

    icon: @image-url("icon.png");
    title: "Nex Speed · Connections";
    background: Colors.bg;
    preferred-width: 480px;
    preferred-height: 440px;
    min-width: 380px;
    min-height: 260px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: root.summary;
            color: Colors.text;
            font-size: 15px;
            font-weight: 600;
            height: 22px;
            vertical-alignment: center;
        }

        NxCard {
            vertical-stretch: 1;

            // Column headers
            HorizontalLayout {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: 18px;
                Text { text: "Application"; color: Colors.dim; font-size: 11px; font-weight: 600; horizontal-stretch: 3; }
                Text { text: "Remote address"; color: Colors.dim; font-size: 11px; font-weight: 600; horizontal-stretch: 2; }
            }

            ListView {
                x: 4px;
                y: 30px;
                width: parent.width - 8px;
                height: parent.height - 34px;
                for row[i] in root.rows: Rectangle {
                    height: 26px;
                    background: mod(i, 2) == 0 ? transparent : Colors.hover;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: row.process;
                            color: Colors.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 3;
                        }
                        Text {
                            text: row.remote;
                            color: Colors.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 2;
                        }
                    }
                }
            }

            if root.rows.length == 0: Text {
                text: "No active connections";
                color: Colors.dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.note;
            color: Colors.dim;
            font-size: 11px;
            height: 16px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
