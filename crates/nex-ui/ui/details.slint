import { Colors } from "theme.slint";

// Nex Speed details window (opened from the tray). Dark theme, fixed size, no Path elements.

export component Details inherits Window {
    in property <string> adapter-name: "No connection";
    in property <bool> online: false;
    in property <string> down-value: "0";
    in property <string> down-unit: "B/s";
    in property <string> up-text: "0 B/s";
    in property <string> peak-text: "0 B/s";
    in property <image> graph;
    in property <string> today-text: "0 B";
    in property <string> month-text: "0 B";
    in property <string> ping-text: "—";
    in property <string> limit-text: "";
    in property <bool> limit-warn: false;
    in property <bool> speedtest-running: false;
    in property <string> speedtest-text: "";
    in property <string> export-text: "";
    callback start-speedtest();
    callback export-csv();
    callback open-connections();
    callback open-history();

    icon: @image-url("icon.png");
    title: "Nex Speed";
    background: Colors.bg;
    preferred-width: 340px;
    preferred-height: 556px;
    min-width: 340px;
    max-width: 340px;
    min-height: 556px;
    max-height: 556px;

    // Connection
    Rectangle {
        x: 20px; y: 24px; width: 8px; height: 8px; border-radius: 4px;
        background: root.online ? Colors.ok : Colors.idle;
    }
    Text {
        x: 36px; y: 18px; width: 280px; height: 20px;
        text: root.adapter-name + "  ·  " + root.ping-text;
        color: Colors.text; font-size: 13px; font-weight: 500; vertical-alignment: center;
    }

    // Hero: download
    Text { x: 20px; y: 56px; text: "Download"; color: Colors.muted; font-size: 13px; }
    Rectangle {
        x: 20px; y: 74px; width: 300px; height: 64px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.down-value; color: Colors.text; font-size: 52px; font-weight: 500; vertical-alignment: center; }
            Text { text: root.down-unit; color: Colors.muted; font-size: 16px; vertical-alignment: center; }
        }
    }
    Text {
        x: 20px; y: 146px; width: 300px; height: 18px;
        text: "Upload " + root.up-text + "     Peak " + root.peak-text;
        color: Colors.muted; font-size: 13px; vertical-alignment: center;
    }

    // Graph panel
    Rectangle {
        x: 18px; y: 178px; width: 304px; height: 126px;
        background: Colors.panel; border-radius: 12px; border-width: 1px; border-color: Colors.border;
        Text { x: 12px; y: 8px; text: "Download"; color: Colors.down; font-size: 11px; }
        Text { x: 78px; y: 8px; text: "Upload"; color: Colors.up; font-size: 11px; }
        Text { x: 200px; y: 8px; width: 92px; text: "Last 60 s"; color: Colors.dim; font-size: 11px; horizontal-alignment: right; }
        Image { source: root.graph; x: 12px; y: 30px; width: 280px; height: 72px; image-fit: fill; }
    }

    // Usage
    Text { x: 20px; y: 324px; text: "Today"; color: Colors.muted; font-size: 12px; }
    Text { x: 20px; y: 342px; text: root.today-text; color: Colors.text; font-size: 18px; font-weight: 600; }
    Text { x: 180px; y: 324px; text: "This month"; color: Colors.muted; font-size: 12px; }
    Text { x: 180px; y: 342px; text: root.month-text; color: Colors.text; font-size: 18px; font-weight: 600; }

    Text {
        x: 20px; y: 372px; width: 300px; height: 16px;
        text: root.limit-text;
        color: root.limit-warn ? Colors.warn : Colors.dim; font-size: 12px;
    }

    // Speed test
    Rectangle {
        x: 18px; y: 398px; width: 304px; height: 36px; border-radius: 9px;
        background: root.speedtest-running ? Colors.button : Colors.primary;
        Text {
            text: root.speedtest-running ? "Testing…" : "Run speed test";
            color: root.speedtest-running ? Colors.muted : Colors.on-primary;
            font-size: 13px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }
        TouchArea {
            enabled: !root.speedtest-running;
            clicked => { root.start-speedtest(); }
        }
    }
    Text {
        x: 18px; y: 440px; width: 304px; height: 20px;
        text: root.speedtest-text;
        color: Colors.muted; font-size: 12px;
        horizontal-alignment: center; vertical-alignment: center;
    }

    // History, export, connections
    Rectangle {
        x: 18px; y: 474px; width: 96px; height: 32px; border-radius: 9px; background: Colors.button;
        Text { text: "History"; color: Colors.text; font-size: 12px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.open-history(); } }
    }
    Rectangle {
        x: 122px; y: 474px; width: 96px; height: 32px; border-radius: 9px; background: Colors.button;
        Text { text: "Connections"; color: Colors.text; font-size: 12px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.open-connections(); } }
    }
    Rectangle {
        x: 226px; y: 474px; width: 96px; height: 32px; border-radius: 9px; background: Colors.button;
        Text { text: "Export CSV"; color: Colors.text; font-size: 12px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.export-csv(); } }
    }
    Text {
        x: 18px; y: 514px; width: 304px; height: 32px;
        text: root.export-text;
        color: Colors.muted; font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: elide;
    }
}
