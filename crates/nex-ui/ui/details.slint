import { Colors } from "theme.slint";
import { NxButton, NxCard, NxStat, NxProgress } from "widgets.slint";

// Nex Speed details window (opened from the tray or by double-clicking the overlay).
// Fixed size, follows the light/dark theme, no Path elements.

export component Details inherits Window {
    in property <string> adapter-name: "No connection";
    in property <bool> online: false;
    in property <string> down-value: "0";
    in property <string> down-unit: "B/s";
    in property <string> up-text: "0 B/s";
    in property <string> peak-text: "0 B/s";
    in property <image> graph;
    in property <string> graph-caption: "Last 60 s";
    in property <string> today-text: "0 B";
    in property <string> month-text: "0 B";
    in property <string> ping-text: "—";
    // Monthly limit: text, 0 = fine / 1 = 80 % used / 2 = reached, and the bar fill (0.0 - 1.0).
    in property <string> limit-text: "";
    in property <int> limit-alert: 0;
    in property <float> limit-fraction: 0;
    in property <bool> has-limit: false;
    in property <bool> speedtest-running: false;
    in property <string> speedtest-text: "";
    in property <string> export-text: "";
    callback start-speedtest();
    callback cancel-speedtest();
    callback export-csv();
    callback open-connections();
    callback open-history();
    callback open-settings();

    icon: @image-url("icon.png");
    title: "Nex Speed";
    background: Colors.bg;
    preferred-width: 340px;
    preferred-height: 652px;
    min-width: 340px;
    max-width: 340px;
    min-height: 652px;
    max-height: 652px;

    property <color> limit-color: root.limit-alert == 2 ? Colors.danger : (root.limit-alert == 1 ? Colors.warn : Colors.down);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        // Connection: status dot, adapter name, latency.
        Rectangle {
            height: 24px;
            Rectangle {
                x: 0px;
                y: 8px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.online ? Colors.ok : Colors.idle;
            }
            Text {
                x: 16px;
                y: 0px;
                width: parent.width - 16px - 92px;
                height: 24px;
                text: root.adapter-name;
                color: Colors.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                x: parent.width - 84px;
                y: 2px;
                width: 84px;
                height: 20px;
                border-radius: 10px;
                background: Colors.button;
                Text {
                    text: "Ping " + root.ping-text;
                    color: Colors.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Hero: current download speed.
        NxCard {
            height: 118px;
            Text { x: 16px; y: 12px; text: "Download"; color: Colors.muted; font-size: 12px; }
            Rectangle {
                x: 16px;
                y: 28px;
                width: parent.width - 32px;
                height: 58px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: root.down-value; color: Colors.text; font-size: 48px; font-weight: 600; vertical-alignment: center; }
                    Text { text: root.down-unit; color: Colors.muted; font-size: 16px; vertical-alignment: center; }
                }
            }
            Text {
                x: 16px;
                y: 92px;
                width: 130px;
                height: 18px;
                text: "↑ " + root.up-text;
                color: Colors.up;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 16px - 150px;
                y: 92px;
                width: 150px;
                height: 18px;
                text: "Session peak " + root.peak-text;
                color: Colors.dim;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // Last 60 seconds.
        NxCard {
            height: 118px;
            Text { x: 14px; y: 10px; text: "● Download"; color: Colors.down; font-size: 11px; }
            Text { x: 96px; y: 10px; text: "● Upload"; color: Colors.up; font-size: 11px; }
            Text {
                x: parent.width - 14px - 170px;
                y: 10px;
                width: 170px;
                text: root.graph-caption;
                color: Colors.dim;
                font-size: 11px;
                horizontal-alignment: right;
            }
            Image {
                source: root.graph;
                x: 14px;
                y: 32px;
                width: parent.width - 28px;
                height: 72px;
                image-fit: fill;
            }
        }

        // Data usage.
        HorizontalLayout {
            spacing: 12px;
            height: 58px;
            NxStat { label: "Today"; value: root.today-text; }
            NxStat { label: "This month"; value: root.month-text; }
        }

        // Monthly limit.
        VerticalLayout {
            spacing: 6px;
            Text {
                text: root.limit-text;
                color: root.limit-alert == 0 ? Colors.muted : root.limit-color;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.has-limit: NxProgress {
                height: 6px;
                value: root.limit-fraction;
                fill: root.limit-color;
            }
        }

        // Speed test (one button: starts, then cancels while running).
        VerticalLayout {
            spacing: 6px;
            NxButton {
                height: 36px;
                primary: !root.speedtest-running;
                text: root.speedtest-running ? "Cancel test" : "Run speed test";
                clicked => {
                    if (root.speedtest-running) {
                        root.cancel-speedtest();
                    } else {
                        root.start-speedtest();
                    }
                }
            }
            Text {
                text: root.speedtest-text;
                color: Colors.muted;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // History, connections, export.
        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            NxButton { text: "History"; clicked => { root.open-history(); } }
            NxButton { text: "Connections"; clicked => { root.open-connections(); } }
            NxButton { text: "Settings"; clicked => { root.open-settings(); } }
        }
        NxButton { height: 34px; text: "Export usage as CSV"; clicked => { root.export-csv(); } }
        Text {
            text: root.export-text;
            color: Colors.muted;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
